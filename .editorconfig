root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,props,targets,csproj,slnf,xml,razor,css,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.sln]
end_of_line = crlf
indent_style = tab

[*.cs]
# Namespaces y usings
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning

# var cuando el tipo es evidente
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_elsewhere = false:silent

# Estilo general
csharp_prefer_braces = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_properties = true:silent
dotnet_style_readonly_field = true:warning
csharp_prefer_simple_using_statement = true:suggestion
csharp_style_prefer_primary_constructors = true:suggestion

# Nombres
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

# IDE0005 (usings innecesarios) requiere GenerateDocumentationFile para ejecutarse en build; se deja como sugerencia.
dotnet_diagnostic.IDE0005.severity = suggestion

[tests/**.cs]
# Nombres de tests legibles: Metodo_Escenario_Resultado
dotnet_diagnostic.CA1707.severity = none
# Los tests no son API pública reutilizable
dotnet_diagnostic.CA1515.severity = none
# ConfigureAwait no aplica en tests de xUnit
dotnet_diagnostic.CA2007.severity = none

[**/Migrations/*.cs]
generated_code = true

# Copiar a deploy/.env (ignorado por git) y completar. Nunca commitear secretos reales.

POSTGRES_DB=breakmanager
POSTGRES_USER=breakmanager
# Obligatoria: definí una clave local.
POSTGRES_PASSWORD=

# Puertos publicados en 127.0.0.1 del host (solo desarrollo).
DB_HOST_PORT=5432
APP_HOST_PORT=8080

# Exportador de métricas: none | console | otlp
TELEMETRY_EXPORTER=none

# Opcional: CA raíz extra (PEM) si un antivirus o proxy intercepta TLS durante el build.
# EXTRA_CA_CERT=C:/Users/usuario/.breakmanager/extra-ca.crt

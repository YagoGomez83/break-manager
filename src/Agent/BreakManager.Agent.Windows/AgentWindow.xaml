<Window x:Class="BreakManager.Agent.Windows.AgentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BreakManager — Puesto"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
  <StackPanel Margin="20">
    <TextBlock x:Name="ErrorText" Foreground="#A4161A" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed" />

    <!-- Enrolamiento (HU-04) -->
    <StackPanel x:Name="EnrollPanel">
      <TextBlock Text="Enrolar este puesto" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
      <TextBlock Text="Dirección del servidor" />
      <TextBox x:Name="ServerUrlBox" Text="https://" Margin="0,2,0,8" />
      <TextBlock Text="Código de enrolamiento (lo da el administrador)" />
      <TextBox x:Name="EnrollmentCodeBox" CharacterCasing="Upper" Margin="0,2,0,12" />
      <Button x:Name="EnrollButton" Content="Enrolar" Click="OnEnrollClick" IsDefault="True" Padding="12,4" HorizontalAlignment="Left" />
    </StackPanel>

    <!-- Login (HU-01) -->
    <StackPanel x:Name="LoginPanel" Visibility="Collapsed">
      <TextBlock x:Name="LoginTitle" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
      <TextBlock Text="Legajo" />
      <TextBox x:Name="EmployeeNumberBox" Margin="0,2,0,8" />
      <TextBlock Text="PIN" />
      <PasswordBox x:Name="PinBox" MaxLength="6" Margin="0,2,0,12" />
      <Button Content="Ingresar" Click="OnLoginClick" IsDefault="True" Padding="12,4" HorizontalAlignment="Left" />
    </StackPanel>

    <!-- Aviso de privacidad (HU-02): no se puede omitir -->
    <StackPanel x:Name="NoticePanel" Visibility="Collapsed">
      <TextBlock Text="Aviso sobre el registro de actividad" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
      <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
        <TextBlock x:Name="NoticeText" TextWrapping="Wrap" />
      </ScrollViewer>
      <StackPanel Orientation="Horizontal">
        <Button Content="Leí y acepto" Click="OnAcceptNoticeClick" Padding="12,4" Margin="0,0,8,0" />
        <Button Content="No acepto" Click="OnRejectNoticeClick" Padding="12,4" />
      </StackPanel>
    </StackPanel>

    <!-- Cambio de PIN temporal -->
    <StackPanel x:Name="PinChangePanel" Visibility="Collapsed">
      <TextBlock Text="Elegí tu PIN" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
      <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                 Text="Tu PIN es temporal. Elegí uno nuevo de 6 dígitos, sin repetidos, secuencias ni tu legajo." />
      <TextBlock Text="PIN nuevo" />
      <PasswordBox x:Name="NewPinBox" MaxLength="6" Margin="0,2,0,8" />
      <TextBlock Text="Repetí el PIN nuevo" />
      <PasswordBox x:Name="ConfirmPinBox" MaxLength="6" Margin="0,2,0,12" />
      <Button Content="Guardar PIN" Click="OnChangePinClick" IsDefault="True" Padding="12,4" HorizontalAlignment="Left" />
    </StackPanel>

    <!-- Sesión abierta -->
    <StackPanel x:Name="SessionPanel" Visibility="Collapsed">
      <TextBlock x:Name="SessionText" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
      <Button Content="Cerrar sesión" Click="OnLogoutClick" Padding="12,4" HorizontalAlignment="Left" />
    </StackPanel>
  </StackPanel>
</Window>

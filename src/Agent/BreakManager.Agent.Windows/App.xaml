<Application x:Class="BreakManager.Agent.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <tb:TaskbarIcon x:Key="TrayIcon"
                    ToolTipText="BreakManager"
                    MenuActivation="LeftOrRightClick">
      <tb:TaskbarIcon.IconSource>
        <tb:GeneratedIconSource Text="B" Foreground="White" Background="#1F4E79" />
      </tb:TaskbarIcon.IconSource>
      <tb:TaskbarIcon.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Abrir" Click="OnOpenClick" />
          <MenuItem Tag="Logout" Header="Cerrar sesión" Click="OnLogoutClick" IsEnabled="False" />
          <Separator />
          <MenuItem Header="Acerca de" Click="OnAboutClick" />
          <Separator />
          <MenuItem Header="Salir" Click="OnExitClick" />
        </ContextMenu>
      </tb:TaskbarIcon.ContextMenu>
    </tb:TaskbarIcon>
  </Application.Resources>
</Application>
